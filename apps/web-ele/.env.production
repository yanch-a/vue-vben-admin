# 静态资源公共路径：Tomcat 部署在 /lmdb/view/ 下必须带此前缀
# 否则 JS/CSS 会去请求 http://host:7806/jse/... 而不是 /lmdb/view/jse/...
VITE_BASE=/lmdb/view/

# 接口地址（与后台 context-path 一致；相对域名根，不是相对页面路径）
VITE_GLOB_API_URL=/lmdb

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
